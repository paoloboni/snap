  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.0.0"
  }
}
